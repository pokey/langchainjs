{
  "name": "@langchain/daytona",
  "version": "0.0.0",
  "description": "Daytona integrations for LangChain.js",
  "author": "LangChain",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:langchain-ai/langchainjs.git"
  },
  "homepage": "https://github.com/langchain-ai/langchainjs/tree/main/libs/providers/langchain-daytona/",
  "scripts": {
    "build": "pnpm --filter @langchain/build compile @langchain/daytona",
    "lint:eslint": "eslint --cache src/",
    "lint:dpdm": "dpdm --skip-dynamic-imports circular --exit-code circular:1 --no-warning --no-tree src/*.ts src/**/*.ts",
    "lint": "pnpm lint:eslint && pnpm lint:dpdm",
    "lint:fix": "pnpm lint:eslint --fix && pnpm lint:dpdm",
    "clean": "rm -rf .turbo dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --mode int",
    "format": "prettier --config .prettierrc --write \"src\"",
    "format:check": "prettier --config .prettierrc --check \"src\""
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.110.2",
    "zod": "^3.25.76 || ^4"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0-alpha.6",
    "@langchain/langgraph": "^1.0.0-alpha.1",
    "langchain": "workspace:*"
  },
  "peerDependenciesMeta": {
    "langchain": {
      "optional": true
    },
    "@langchain/core": {
      "optional": false
    },
    "@langchain/langgraph": {
      "optional": false
    }
  },
  "devDependencies": {
    "@langchain/anthropic": "workspace:*",
    "@langchain/core": "workspace:*",
    "@langchain/openai": "workspace:*",
    "@langchain/eslint": "workspace:*",
    "@langchain/langgraph-checkpoint": "^0.1.1",
    "@tsconfig/recommended": "^1.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.1",
    "dpdm": "^3.14.0",
    "eslint": "^9.34.0",
    "langchain": "workspace:*",
    "prettier": "^2.8.3",
    "release-it": "^19.0.4",
    "release-it-pnpm": "^4.6.6",
    "rimraf": "^5.0.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "llm",
    "ai",
    "chain",
    "prompt",
    "prompt engineering",
    "machine learning",
    "ml",
    "daytona",
    "sandbox",
    "code execution"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "input": "./src/index.ts"
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware/index.d.ts",
        "default": "./dist/middleware/index.js"
      },
      "require": {
        "types": "./dist/middleware/index.d.cts",
        "default": "./dist/middleware/index.cjs"
      },
      "input": "./src/middleware/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ]
}
